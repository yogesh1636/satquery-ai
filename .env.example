# SatQuery AI — OAuth Environment Configuration
# Copy this file to .env or .env.local to configure real Google and Microsoft OAuth login

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized JavaScript origin: http://localhost:5173 and https://yogesh1636.github.io
# Authorized redirect URI: http://localhost:5173/ and https://yogesh1636.github.io/satquery-ai/
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra ID (Azure AD) Application / Client ID (from Microsoft Entra ID -> App registrations)
# Redirect URI (SPA): http://localhost:5173/ and https://yogesh1636.github.io/satquery-ai/
VITE_MICROSOFT_CLIENT_ID=
